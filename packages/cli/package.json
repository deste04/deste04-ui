{
  "name": "deste04-ui",
  "version": "0.1.2",
  "description": "CLI per installare i componenti di deste04-ui direttamente nel tuo progetto (components/ui/...)",
  "type": "module",
  "license": "MIT",
  "bin": {
    "deste04-ui": "./src/cli.js"
  },
  "exports": {
    "./package.json": "./package.json",
    "./components/ui/button": "./templates/components/ui/button.tsx",
    "./components/ui/button.tsx": "./templates/components/ui/button.tsx",
    "./components/ui/copy-button": "./templates/components/ui/copy-button.tsx",
    "./components/ui/copy-button.tsx": "./templates/components/ui/copy-button.tsx",
    "./components/ui/spinner": "./templates/components/ui/spinner.tsx",
    "./components/ui/spinner.tsx": "./templates/components/ui/spinner.tsx",
    "./components/ui/link": "./templates/components/ui/link.tsx",
    "./components/ui/link.tsx": "./templates/components/ui/link.tsx",
    "./components/ui/input": "./templates/components/ui/input.tsx",
    "./components/ui/input.tsx": "./templates/components/ui/input.tsx",
    "./components/ui/label": "./templates/components/ui/label.tsx",
    "./components/ui/label.tsx": "./templates/components/ui/label.tsx",
    "./components/ui/separator": "./templates/components/ui/separator.tsx",
    "./components/ui/separator.tsx": "./templates/components/ui/separator.tsx",
    "./components/ui/field": "./templates/components/ui/field.tsx",
    "./components/ui/field.tsx": "./templates/components/ui/field.tsx",
    "./components/ui/textarea": "./templates/components/ui/textarea.tsx",
    "./components/ui/textarea.tsx": "./templates/components/ui/textarea.tsx",
    "./components/ui/switch": "./templates/components/ui/switch.tsx",
    "./components/ui/switch.tsx": "./templates/components/ui/switch.tsx",
    "./components/ui/checkbox": "./templates/components/ui/checkbox.tsx",
    "./components/ui/checkbox.tsx": "./templates/components/ui/checkbox.tsx",
    "./components/ui/radio-group": "./templates/components/ui/radio-group.tsx",
    "./components/ui/radio-group.tsx": "./templates/components/ui/radio-group.tsx",
    "./components/ui/badge": "./templates/components/ui/badge.tsx",
    "./components/ui/badge.tsx": "./templates/components/ui/badge.tsx",
    "./styles/global.css": "./templates/styles/global.css",
    "./lib/utils": "./templates/lib/utils.ts",
    "./registry.json": "./registry.json"
  },
  "files": [
    "src",
    "templates",
    "registry.json"
  ],
  "keywords": [
    "ui",
    "components",
    "cli",
    "react"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "tailwind-merge": "^3.6.0",
    "torph": "^0.1.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "tailwindcss": ">=4"
  }
}
